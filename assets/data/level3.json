 "results": 1,
 "intro": "Atrás da porta de ferro, um túnel sobe pela montanha até a fortaleza do Vargas, no alto da serra. Do outro lado dela fica a estação velha — e o trem com a Isis. Siga os lápis dela.",
 "introImg": "res://assets/ui/cut_ep3_fort.jpg",
 "introSub": "EPISÓDIO 3",
 "endTitle": "FIM DO COVIL",
 "periods": [
  "A trilha da serra",
  "O pátio dos vigias",
  "Os porões",
  "As forjas",
  "As torres",
  "Dentro do trem",
  "A ponte"
 ],
 "clueIds": [
  13,
